{
	"name": "otherscape-screen",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"check": "biome check --write",
		"ci": "biome ci",
		"typecheck": "tsc --noEmit",
		"test": "node --import 'data:text/javascript,import { register } from \"node:module\"; import { pathToFileURL } from \"node:url\"; register(\"./scripts/resolve-alias-hook.mjs\", pathToFileURL(\"./\"));' --test",
		"upload-content": "node --env-file=.env.local scripts/upload-content.mjs",
		"prepare": "git config core.hooksPath .githooks",
		"dev:vinext": "vite dev --port 3001",
		"build:vinext": "vite build",
		"start:vinext": "vite preview",
		"deploy:vinext": "vinext-cloudflare deploy"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@sentry/nextjs": "^11.1.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.116.0",
		"@vinext/cloudflare": "^1.3.3",
		"next": "16.3.5",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-server-dom-webpack": "^19.3.1",
		"vinext": "^1.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@cloudflare/vite-plugin": "^2.0.0-beta.v.11",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.2.1",
		"@vitejs/plugin-rsc": "^0.5.38",
		"cf": "^1.0.0-beta.27",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vite": "^8.3.0"
	}
}
